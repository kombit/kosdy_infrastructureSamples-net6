<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.serviceModel>
        <bindings>
            <customBinding>
                <binding name="Bevilling">
                    <textMessageEncoding messageVersion="Soap12" />
                    <httpTransport />
                </binding>
            </customBinding>
        </bindings>
        <client>
            <endpoint address="http://kombit.dk/sts/ydelseindeks/bevillingindeks"
                binding="customBinding" bindingConfiguration="Bevilling" contract="Kombit.InfrastructureSamples.BevillingIndeksService.BevillingPortType"
                name="BevillingIndeks" />
        </client>
    </system.serviceModel>
</configuration>